{
  "name": "bsv-headers",
  "version": "3.0.5",
  "description": "Determine best-work bitcoin header chain and query block order",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "docs": "typedoc",
    "prepare": "npm run build && npm run docs",
    "test": "ts-node ./tests/index.ts"
  },
  "keywords": [
    "Bitcoin",
    "Bitcoin SV",
    "BSV",
    "blocks",
    "headers",
    "chain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinejohn/bsv-headers.git"
  },
  "bugs": {
    "url": "https://github.com/kevinejohn/bsv-headers/issues"
  },
  "homepage": "https://github.com/kevinejohn/bsv-headers#readme",
  "author": "Kevin Johnson",
  "contributors": [
    "Andrew Johnson <andrewj@hey.com>"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bsv-minimal": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3"
  }
}
